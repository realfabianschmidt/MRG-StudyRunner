{
  "api_version": 5,
  "plugin_key": "example_sensor",
  "config_key": "example_sensor",
  "version": "1.0.0",
  "category": "biosignal",
  "ui": {
    "label": "Example sensor",
    "description": "Plugin SDK template for a new recording sensor. Rename plugin_key/config_key and every 'example_sensor' occurrence (manifest, plugin.py, adapter.py, driver.py) before shipping -- tools/plugin_sdk.py new does this for you.",
    "order": 9999
  },
  "capabilities": {
    "study_sensor": {"default_enabled": false, "default_required": true},
    "acquisition_transport": {"transport": "serial", "delivery": "host_lsl_bridge"},
    "lsl_stream_provider": {},
    "recording_source": {"artifact": "xdf", "primary_stream": "measurements", "start_sample_policy": "all_regular"},
    "backup_projection": {
      "stale_after_ms": 2500,
      "channels": [
        {"output": "value", "stream": "measurements", "channel": "value"}
      ]
    },
    "live_view": {
      "series": [
        {"key": "value", "stream": "measurements", "channels": ["value"], "label": "Value"}
      ]
    },
    "health": {},
    "connection": {
      "device_noun_key": "sensorConnection.noun.device",
      "signal_label_key": "sensorConnection.signal.signal",
      "setup_per_participant": false
    },
    "machine_settings": {},
    "study_settings": {}
  },
  "runtime": {
    "entrypoint": "driver.py",
    "protocol": "study-runner-stdio/v1",
    "sample_delivery": "declared_transport",
    "actions": ["start", "stop"],
    "trial_events": ["session_end"]
  },
  "streams": [
    {
      "key": "measurements",
      "source_id": "study_runner.example_sensor.measurements",
      "type": "EXAMPLE",
      "nominal_rate_hz": 4,
      "clock_domain": "lsl",
      "channel_format": "double64",
      "channels": ["value", "seq"],
      "channel_units": ["arbitrary_unit", "count"],
      "sequence_channel": "seq",
      "timing": {"timestamp_source": "host_arrival"}
    }
  ]
}
