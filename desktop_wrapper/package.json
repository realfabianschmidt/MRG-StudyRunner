{
  "name": "study-runner-desktop",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "npm run build:sidecar && tauri build",
    "build:sidecar": "node scripts/build-sidecar.mjs --sidecar",
    "build:server:onedir": "node scripts/build-sidecar.mjs --onedir",
    "release": "node ../release_tools/release-study-runner.mjs release",
    "release:prepare": "node ../release_tools/release-study-runner.mjs prepare",
    "release:publish": "node ../release_tools/release-study-runner.mjs publish",
    "release:status": "node ../release_tools/release-study-runner.mjs status"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
