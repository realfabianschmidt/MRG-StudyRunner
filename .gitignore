software/study_runner/integrations/camera_emotion/worker/deepface_home/
software/study_runner/integrations/local_emotion_worker/model_assets/*.h5
software/study_runner/integrations/camera_emotion/worker/model_assets/*.h5
.secrets/

# Environment and editor tooling
