{
  "version": 1,
  "sample_metadata_model": [
    "source_epoch_ms",
    "server_received_epoch_ms",
    "processing_epoch_ms",
    "sequence_number",
    "latency_ms",
    "clock_domain",
    "drop_count"
  ],
  "plugins": {
    "brainbit": {
      "capabilities": ["runtime_control", "status_poll", "recording", "interval_summary", "sidecar_export", "lsl_stream"],
      "streams": [
        {"key": "eeg", "clock_domain": "lsl", "format": "xdf", "source_timestamp": "lsl"},
        {"key": "derived_metrics", "clock_domain": "lsl", "format": "xdf_or_sidecar", "source_timestamp": "source_or_server"}
      ],
      "poll_interval_ms": 1000,
      "request_timeout_ms": 500,
      "clock_domain": "lsl",
      "expected_data_rate": {"eeg_hz": 250, "metrics_hz": 1},
      "backpressure": {"max_in_flight": 1, "drop_policy": "latest_status_wins"},
      "runtime_settings": {
        "scan_seconds": {"type": "number", "unit": "s", "default": 5},
        "disconnect_timeout_ms": {"type": "number", "unit": "ms", "default": 20000},
        "lsl.enabled": {"type": "boolean", "default": false}
      }
    },
    "mini_radar": {
      "capabilities": ["runtime_control", "status_poll", "recording", "interval_summary", "sidecar_export", "lsl_stream"],
      "streams": [
        {"key": "presence", "clock_domain": "lsl", "format": "xdf_or_sidecar", "source_timestamp": "source_or_server"},
        {"key": "heart_rate", "clock_domain": "lsl", "format": "xdf_or_sidecar", "source_timestamp": "source_or_server"},
        {"key": "respiration", "clock_domain": "lsl", "format": "xdf_or_sidecar", "source_timestamp": "source_or_server"}
      ],
      "poll_interval_ms": 1000,
      "request_timeout_ms": 500,
      "clock_domain": "lsl",
      "expected_data_rate": {"vitals_hz": 1},
      "backpressure": {"max_in_flight": 1, "drop_policy": "latest_status_wins"},
      "runtime_settings": {
        "connection_type": {"type": "choice", "default": "serial"},
        "data_timeout_seconds": {"type": "number", "unit": "s", "default": 5},
        "ble.scan_timeout_seconds": {"type": "number", "unit": "s", "default": 5},
        "lsl.enabled": {"type": "boolean", "default": false}
      }
    },
    "camera_emotion": {
      "capabilities": ["runtime_control", "status_poll", "recording", "interval_summary", "sidecar_export", "lsl_stream", "backpressure"],
      "streams": [
        {"key": "frame", "clock_domain": "tablet_performance", "format": "http_frame", "source_timestamp": "client_trigger_epoch_ms"},
        {"key": "emotion", "clock_domain": "server", "format": "sidecar", "source_timestamp": "server_received_epoch_ms"}
      ],
      "poll_interval_ms": 1000,
      "request_timeout_ms": 750,
      "clock_domain": "tablet_performance",
      "expected_data_rate": {"frames_hz": 1},
      "backpressure": {"max_in_flight": 1, "drop_policy": "drop_new_frame_while_busy"},
      "runtime_settings": {
        "snapshot_interval_ms": {"type": "number", "unit": "ms", "default": 1000, "minimum": 1000},
        "emotion_worker_timeout_ms": {"type": "number", "unit": "ms", "default": 5000},
        "worker_mode": {"type": "choice", "default": "local_worker"},
        "lsl.enabled": {"type": "boolean", "default": false}
      }
    },
    "emotion_worker": {
      "capabilities": ["runtime_control", "status_poll", "processing", "repair"],
      "streams": [
        {"key": "emotion_inference", "clock_domain": "server", "format": "http_json", "source_timestamp": "server_received_epoch_ms"}
      ],
      "poll_interval_ms": 1000,
      "request_timeout_ms": 1000,
      "clock_domain": "server",
      "expected_data_rate": {"inference_hz": 1},
      "backpressure": {"max_in_flight": 1, "drop_policy": "caller_drops_frames"},
      "runtime_settings": {
        "emotion_worker_url": {"type": "url", "default": "http://127.0.0.1:3001"},
        "auto_start": {"type": "boolean", "default": true}
      }
    },
    "lsl": {
      "capabilities": ["status_poll", "marker_stream"],
      "streams": [
        {"key": "markers", "clock_domain": "lsl", "format": "xdf", "source_timestamp": "lsl"}
      ],
      "poll_interval_ms": 2000,
      "request_timeout_ms": 250,
      "clock_domain": "lsl",
      "expected_data_rate": {"markers_hz": 0},
      "backpressure": {"max_in_flight": 1, "drop_policy": "never_drop_markers"},
      "runtime_settings": {
        "enabled": {"type": "boolean", "default": false}
      }
    },
    "osc": {
      "capabilities": ["status_poll", "marker_forwarding"],
      "streams": [
        {"key": "osc_events", "clock_domain": "server", "format": "udp", "source_timestamp": "server_send_epoch_ms"}
      ],
      "poll_interval_ms": 2000,
      "request_timeout_ms": 250,
      "clock_domain": "server",
      "expected_data_rate": {"events_hz": 0},
      "backpressure": {"max_in_flight": 1, "drop_policy": "best_effort_udp"},
      "runtime_settings": {
        "host": {"type": "string", "default": "127.0.0.1"},
        "port": {"type": "number", "default": 8000}
      }
    },
    "labrecorder": {
      "capabilities": ["status_poll", "xdf_recording"],
      "streams": [
        {"key": "xdf", "clock_domain": "lsl", "format": "xdf", "source_timestamp": "lsl"}
      ],
      "poll_interval_ms": 2000,
      "request_timeout_ms": 500,
      "clock_domain": "lsl",
      "expected_data_rate": {"xdf_hz": 0},
      "backpressure": {"max_in_flight": 1, "drop_policy": "n/a"},
      "runtime_settings": {
        "enabled": {"type": "boolean", "default": false},
        "recording_dir": {"type": "path", "default": "recordings"}
      }
    },
    "notion": {
      "capabilities": ["status_poll", "upload_destination"],
      "streams": [],
      "poll_interval_ms": 5000,
      "request_timeout_ms": 1000,
      "clock_domain": "server",
      "expected_data_rate": {},
      "backpressure": {"max_in_flight": 1, "drop_policy": "upload_job_queue"},
      "runtime_settings": {
        "database_id": {"type": "string", "default": ""},
        "upload_enabled": {"type": "boolean", "default": false}
      }
    }
  }
}
