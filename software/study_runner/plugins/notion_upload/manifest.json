{
  "api_version": 4,
  "plugin_key": "notion",
  "version": "1.0.0",
  "category": "storage",
  "config_key": "notion",
  "entry_point": "plugin:PLUGIN",
  "runtime": {
    "entrypoint": "driver.py",
    "protocol": "study-runner-stdio/v1",
    "interactive_stdin": true,
    "modes": ["runtime", "diagnostics"],
    "sample_delivery": "none",
    "actions": [],
    "trial_events": [],
    "can_toggle": true,
    "sidecar": {}
  },
  "lifecycle": {"reinitialize_on_disable": true},
  "ui": {
    "label": "Notion upload",
    "description": "Publishes finalized result and card-summary JSON to Notion.",
    "order": 600,
    "visibility": {
      "dashboard": false,
      "settings_hub": true,
      "study_settings": true,
      "destination_settings": true
    }
  },
  "capabilities": {
    "upload_destination": {
      "destination": "notion",
      "default_enabled": false,
      "requires_valid_result": true,
      "publish_on_attention": false,
      "republish_on_degraded": false,
      "purge_verified_sources": false,
      "legacy": {
        "enabled_field": "notion_enabled",
        "settings": {
          "parent_page_id": "notion_parent_page_id",
          "database_id": "notion_database_id",
          "data_source_id": "notion_data_source_id"
        }
      }
    },
    "readiness": {},
    "readiness_requirements": {
      "requires_secret": true,
      "requires_settings": ["parent_page_id", "database_id"],
      "requires_machine_enabled": true
    },
    "health": {},
    "machine_settings": {},
    "study_settings": {},
    "credentials": {
      "config_field": "api_key",
      "env_var": "STUDY_RUNNER_NOTION_API_KEY",
      "per_study": true
    },
    "admin_actions": {
      "actions": [
        {
          "key": "test_connection",
          "label": "Test connection",
          "payload_schema": {
            "api_key": {"type": "string", "required": false, "max_length": 256},
            "timeout_seconds": {"type": "integer", "required": false, "minimum": 1, "maximum": 120}
          }
        }
      ]
    }
  },
  "streams": [],
  "settings": {
    "machine": {
      "enabled": {
        "type": "boolean", "path": "enabled", "default": true,
        "label_key": "pluginSettings.common.enabled", "apply": "immediate", "scope": "machine"
      },
      "auto_retry_failed": {
        "type": "boolean", "path": "auto_retry_failed", "default": true,
        "label_key": "pluginSettings.notion.autoRetry", "apply": "immediate", "scope": "machine"
      },
      "timeout_seconds": {
        "type": "number", "unit": "s", "path": "timeout_seconds", "default": 10,
        "minimum": 1, "maximum": 120, "label_key": "pluginSettings.common.timeoutSeconds",
        "apply": "immediate", "scope": "machine"
      }
    },
    "study": {
      "parent_page_id": {"type": "string", "default": ""},
      "database_id": {"type": "string", "default": ""},
      "data_source_id": {"type": "string", "default": "", "read_only": true}
    },
    "card_actions": {}
  },
  "poll_interval_ms": 5000,
  "request_timeout_ms": 1000,
  "clock_domain": "server",
  "expected_data_rate": {},
  "backpressure": {"max_in_flight": 1, "drop_policy": "upload_job_queue"}
}
