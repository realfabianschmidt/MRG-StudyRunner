{
  "api_version": 5,
  "plugin_key": "osc",
  "version": "1.1.0",
  "category": "output",
  "config_key": "osc",
  "runtime": {
    "entrypoint": "driver.py",
    "protocol": "study-runner-stdio/v1",
    "interactive_stdin": true,
    "modes": ["runtime", "diagnostics"],
    "sample_delivery": "none",
    "actions": [],
    "trial_events": ["start", "stop"],
    "can_toggle": true,
    "sidecar": {}
  },
  "ui": {
    "label": "OSC / TouchDesigner",
    "description": "Forwards study events to TouchDesigner over OSC.",
    "help_key": "pluginHelp.osc.intro",
    "order": 400,
    "visibility": {
      "dashboard": true,
      "settings_hub": true,
      "study_settings": false,
      "destination_settings": false
    }
  },
  "capabilities": {
    "health": {},
    "machine_settings": {},
    "marker_forwarding": {}
  },
  "streams": [],
  "settings": {
    "machine": {
      "host": {
        "type": "string", "path": "host", "default": "127.0.0.1",
        "label_key": "pluginSettings.osc.host", "apply": "immediate", "scope": "machine",
        "help_key": "pluginHelp.osc.host"
      },
      "port": {
        "type": "number", "path": "port", "default": 8000, "minimum": 1, "maximum": 65535,
        "label_key": "pluginSettings.osc.port", "apply": "immediate", "scope": "machine",
        "help_key": "pluginHelp.osc.port"
      }
    },
    "study": {}
  },
  "poll_interval_ms": 2000,
  "request_timeout_ms": 250,
  "clock_domain": "server",
  "expected_data_rate": {"events_hz": 0},
  "backpressure": {"max_in_flight": 1, "drop_policy": "best_effort_udp"}
}
