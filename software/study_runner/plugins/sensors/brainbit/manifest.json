{
  "api_version": 5,
  "plugin_key": "brainbit",
  "version": "1.0.1",
  "category": "biosignal",
  "config_key": "brainbit",
  "runtime": {
    "entrypoint": "driver.py",
    "protocol": "study-runner-stdio/v1",
    "interactive_stdin": true,
    "modes": ["runtime", "diagnostics"],
    "sample_delivery": "declared_transport",
    "stream_contract": "status_actual_streams",
    "operation_timeouts_ms": {
      "initialize": 75000,
      "status": 2000,
      "start": 75000,
      "stop": 15000,
      "restart": 90000,
      "admin_action": 90000,
      "trial_start": 2000,
      "trial_stop": 2000,
      "session_end": 5000,
      "interval_summary": 5000,
      "interval_export": 15000,
      "shutdown": 15000
    },
    "actions": ["start", "stop", "restart"],
    "trial_events": ["start", "stop", "session_end"],
    "can_toggle": true,
    "sidecar": {
      "sensor": "brainbit",
      "filename_suffix": "brainbit_signals",
      "output_key": "brainbit_file"
    }
  },
  "ui": {
    "label": "BrainBit",
    "description": "BrainBit EEG acquisition and derived metrics.",
    "help_key": "pluginHelp.brainbit.intro",
    "order": 100,
    "visibility": {
      "dashboard": true,
      "settings_hub": true,
      "study_settings": true,
      "destination_settings": false
    },
    "extensions": {"dashboard": "ui/dashboard.js"},
    "timeline": {
      "lane_aliases": [],
      "preferred_channels": [
        "alpha", "beta", "theta", "delta", "gamma"
      ]
    }
  },
  "capabilities": {
    "study_sensor": {"default_enabled": true, "default_required": true},
    "acquisition_transport": {
      "transport": "ble",
      "delivery": "host_lsl_bridge"
    },
    "lsl_stream_provider": {},
    "recording_source": {"artifact": "xdf", "primary_stream": "eeg"},
    "backup_projection": {
      "rate_hz": 1,
      "stale_after_ms": 2500,
      "channels": [
        {"output": "attention", "stream": "mental", "channel": "Rel_Attention"},
        {"output": "relaxation", "stream": "mental", "channel": "Rel_Relaxation"}
      ]
    },
    "health": {},
    "connection": {
      "device_noun_key": "sensorConnection.noun.headband",
      "signal_label_key": "sensorConnection.signal.electrodeContact",
      "setup_label_key": "sensorConnection.setup.calibration",
      "setup_per_participant": true
    },
    "machine_settings": {},
    "study_settings": {},
    "card_actions": {},
    "interval_summary": {},
    "sidecar_export": {},
    "admin_actions": {
      "actions": [
        {
          "key": "select_device",
          "role": "select",
          "label": "Select headband",
          "description": "Remember this BrainBit band and connect to it.",
          "payload_schema": {
            "index": {"type": "integer", "minimum": 0},
            "name": {"type": "string", "max_length": 256},
            "address": {"type": "string", "max_length": 256},
            "serial_number": {"type": "string", "max_length": 256}
          },
          "any_of_required": ["address", "serial_number"],
          "instances": {
            "presentation": "select",
            "status_paths": ["scan_candidates", "latest.scan_candidates"],
            "payload_map": {
              "index": "index",
              "name": "name",
              "address": "address",
              "serial_number": "serial"
            },
            "label_fields": ["name", "serial", "serial_number", "address"]
          }
        },
        {"key": "scan_devices", "role": "scan", "label": "Search", "description": "Search for BrainBit headbands once. Exactly one found is connected automatically; several are listed to choose from."},
        {"key": "check_contact", "role": "measure_signal", "label": "Measure contact", "description": "Pause the EEG for about 6 s and measure the electrode contact, without reconnecting."},
        {"key": "calibrate", "role": "initialize", "label": "Initialize", "description": "Calibrate the attention and relaxation indices for this participant (about 6 s, sitting still, eyes open)."},
        {
          "key": "auto_reconnect",
          "role": "auto_reconnect",
          "label": "Auto-reconnect",
          "description": "Restore a lost connection to the same headband by itself, once a headband was connected and the study runs.",
          "payload_schema": {"enabled": {"type": "boolean", "required": true}}
        }
      ]
    }
  },
  "streams": [
    {
      "key": "diagnostics", "source_id": "study_runner.brainbit.diagnostics", "type": "DIAGNOSTICS",
      "nominal_rate_hz": 0, "clock_domain": "lsl", "channel_format": "string",
      "channels": ["event"], "channel_units": ["json"]
    },
    {
      "key": "eeg", "source_id": "study_runner.brainbit.eeg", "type": "EEG",
      "nominal_rate_hz": 250, "clock_domain": "lsl", "channel_format": "float32",
      "channels": ["O1", "O2", "T3", "T4"],
      "channel_units": ["microvolt", "microvolt", "microvolt", "microvolt"]
    },
    {
      "key": "bands", "source_id": "study_runner.brainbit.bands", "type": "BANDS",
      "nominal_rate_hz": 25, "clock_domain": "lsl", "channel_format": "float32",
      "channels": ["delta", "theta", "alpha", "beta", "gamma"],
      "channel_units": ["relative_power", "relative_power", "relative_power", "relative_power", "relative_power"]
    },
    {
      "key": "mental", "source_id": "study_runner.brainbit.mental", "type": "MENTAL",
      "nominal_rate_hz": 25, "clock_domain": "lsl", "channel_format": "float32",
      "channels": ["Inst_Attention", "Inst_Relaxation", "Rel_Attention", "Rel_Relaxation"],
      "channel_units": ["ratio", "ratio", "ratio", "ratio"]
    },
    {
      "key": "quality", "source_id": "study_runner.brainbit.quality", "type": "QUALITY",
      "nominal_rate_hz": 0, "may_be_empty": true, "clock_domain": "lsl", "channel_format": "float32",
      "channels": ["O1", "O2", "T3", "T4"],
      "channel_units": ["ratio", "ratio", "ratio", "ratio"]
    },
    {
      "key": "battery", "source_id": "study_runner.brainbit.battery", "type": "BATTERY",
      "nominal_rate_hz": 0, "may_be_empty": true, "clock_domain": "lsl", "channel_format": "float32",
      "channels": ["percent"],
      "channel_units": ["percent"]
    }
  ],
  "settings": {
    "machine": {
      "scan_seconds": {
        "type": "number", "unit": "s", "path": "scan_seconds", "default": 5,
        "minimum": 1, "maximum": 60, "label_key": "pluginSettings.brainbit.scanSeconds",
        "apply": "restart", "scope": "machine",
        "help_key": "pluginHelp.brainbit.scanSeconds"
      },
      "disconnect_timeout_ms": {
        "type": "number", "unit": "ms", "path": "disconnect_timeout_ms", "default": 45000,
        "minimum": 1000, "maximum": 120000,
        "label_key": "pluginSettings.brainbit.disconnectTimeout", "apply": "restart", "scope": "machine",
        "help_key": "pluginHelp.brainbit.disconnectTimeout"
      },
      "serial_number": {
        "type": "string", "path": "serial_number", "default": "",
        "label_key": "pluginSettings.brainbit.serialNumber", "apply": "restart", "scope": "machine",
        "help_key": "pluginHelp.brainbit.serialNumber"
      },
      "device_address": {
        "type": "string", "path": "device_address", "default": "",
        "label_key": "pluginSettings.brainbit.deviceAddress", "apply": "restart", "scope": "machine",
        "help_key": "pluginHelp.brainbit.deviceAddress"
      },
      "device_name": {
        "type": "string", "path": "device_name", "default": "",
        "label_key": "pluginSettings.brainbit.deviceName", "apply": "restart", "scope": "machine",
        "help_key": "pluginHelp.brainbit.deviceName"
      },
      "settle_seconds": {
        "type": "number", "unit": "s", "path": "settle_seconds", "default": 2,
        "minimum": 0, "maximum": 30,
        "label_key": "pluginSettings.brainbit.settleSeconds", "apply": "restart", "scope": "machine",
        "help_key": "pluginHelp.brainbit.settleSeconds"
      },
      "auto_reconnect": {
        "type": "boolean", "path": "auto_reconnect", "default": true,
        "label_key": "pluginSettings.brainbit.autoReconnect", "apply": "immediate", "scope": "machine",
        "help_key": "pluginHelp.brainbit.autoReconnect"
      },
      "auto_restart_max_attempts": {
        "type": "number", "path": "auto_restart_max_attempts", "default": 3,
        "minimum": 0, "maximum": 20,
        "label_key": "pluginSettings.brainbit.autoRestartMaxAttempts", "apply": "restart", "scope": "machine",
        "help_key": "pluginHelp.brainbit.autoRestartMaxAttempts"
      }
    },
    "study": {},
    "card_actions": {
      "to_touchdesigner": {
        "type": "boolean",
        "default": true,
        "help_key": "pluginHelp.brainbit.toTouchdesigner"
      }
    }
  },
  "poll_interval_ms": 1000,
  "request_timeout_ms": 1500,
  "clock_domain": "lsl",
  "expected_data_rate": {"eeg_hz": 250, "metrics_hz": 25, "backup_projection_hz": 1},
  "backpressure": {"max_in_flight": 1, "drop_policy": "latest_status_wins"}
}
