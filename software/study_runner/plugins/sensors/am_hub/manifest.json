{
  "api_version": 5,
  "plugin_key": "am_hub",
  "version": "5.0.0",
  "category": "biosignal",
  "config_key": "am_hub",
  "runtime": {
    "entrypoint": "driver.py",
    "protocol": "study-runner-stdio/v1",
    "interactive_stdin": true,
    "modes": [
      "runtime",
      "diagnostics"
    ],
    "sample_delivery": "declared_transport",
    "actions": [
      "start",
      "stop",
      "restart"
    ],
    "trial_events": [
      "start",
      "stop"
    ],
    "operation_timeouts_ms": {
      "trial_start": 2500,
      "trial_stop": 2500
    },
    "can_toggle": true,
    "sidecar": {
      "sensor": "am_hub",
      "filename_suffix": "am_hub_signals",
      "output_key": "am_hub_file"
    }
  },
  "lifecycle": {
    "reinitialize_on_disable": true
  },
  "ui": {
    "label": "AM Hub",
    "description": "Radar, bio and valve frames from the Parasite AM Hub (one sample per real frame) with the estimated board-to-Study-Runner latency, the hub's own events (including every frame verbatim), and the hub clock from a ping every second. Stimulus cards can also start and stop the hub's actuators.",
    "help_key": "pluginHelp.amHub.intro",
    "order": 120,
    "visibility": {
      "dashboard": true,
      "settings_hub": true,
      "study_settings": true,
      "destination_settings": false
    },
    "extensions": {
      "dashboard": "ui/dashboard.js"
    },
    "timeline": {
      "lane_aliases": [
        "am_hub"
      ],
      "preferred_channels": [
        "presMoveEnergy",
        "presStaticEnergy",
        "heartBpm",
        "breathRate",
        "personX",
        "personY"
      ]
    }
  },
  "capabilities": {
    "study_sensor": {
      "default_enabled": false,
      "default_required": false
    },
    "acquisition_transport": {
      "transport": "network_adapter",
      "delivery": "host_lsl_bridge"
    },
    "lsl_stream_provider": {},
    "recording_source": {
      "artifact": "xdf",
      "primary_stream": "radar"
    },
    "backup_projection": {
      "stale_after_ms": 2500,
      "channels": [
        {
          "output": "presence",
          "stream": "radar",
          "channel": "presence"
        },
        {
          "output": "movement_energy",
          "stream": "radar",
          "channel": "presMoveEnergy"
        },
        {
          "output": "person_distance_mm",
          "stream": "radar",
          "channel": "personDist"
        },
        {
          "output": "heart_rate_bpm",
          "stream": "bio",
          "channel": "heartBpm"
        },
        {
          "output": "breath_rate_per_min",
          "stream": "bio",
          "channel": "breathRate"
        }
      ]
    },
    "live_view": {
      "channel_key_prefix": "amHub.channel",
      "series": [
        {
          "key": "movement",
          "stream": "radar",
          "channels": [
            "presMoveEnergy",
            "presStaticEnergy"
          ],
          "label_key": "amHub.monitor.movement",
          "label": "Movement & presence energy",
          "min_span": 5
        },
        {
          "key": "vitals",
          "stream": "bio",
          "channels": [
            "heartBpm",
            "breathRate"
          ],
          "label_key": "amHub.monitor.vitals",
          "label": "Heart & breathing rate",
          "min_span": 10,
          "unit_label": " /min"
        },
        {
          "key": "position",
          "stream": "radar",
          "channels": [
            "personX",
            "personY"
          ],
          "label_key": "amHub.monitor.position",
          "label": "Position (relative to the sensor)",
          "axis": "signed",
          "min_span": 100,
          "unit_label": " mm"
        }
      ]
    },
    "health": {},
    "connection": {
      "device_noun_key": "sensorConnection.noun.hub",
      "signal_label_key": "sensorConnection.signal.presence",
      "setup_per_participant": false
    },
    "machine_settings": {},
    "study_settings": {},
    "interval_summary": {},
    "sidecar_export": {},
    "admin_actions": {
      "actions": [
        {
          "key": "auto_reconnect",
          "role": "auto_reconnect",
          "label": "Auto-reconnect",
          "description": "Restore a lost AM Hub connection by itself.",
          "payload_schema": {
            "enabled": {
              "type": "boolean",
              "required": true
            }
          }
        }
      ]
    }
  },
  "streams": [
    {
      "key": "radar",
      "source_id": "study_runner.am_hub.radar",
      "type": "RADAR",
      "nominal_rate_hz": 10,
      "clock_domain": "lsl",
      "channel_format": "double64",
      "channels": [
        "personDist",
        "personX",
        "personY",
        "targetCount",
        "t1x",
        "t1y",
        "t1speed",
        "t1res",
        "t2x",
        "t2y",
        "t2speed",
        "t2res",
        "t3x",
        "t3y",
        "t3speed",
        "t3res",
        "presence",
        "presState",
        "presDist",
        "presMoveEnergy",
        "presStaticEnergy",
        "presDetDist",
        "rssi",
        "seq",
        "hub_timestamp",
        "latency_ms",
        "radio_rtt_ms",
        "clock_offset_ms",
        "correction_ms"
      ],
      "channel_units": [
        "millimetre",
        "millimetre",
        "millimetre",
        "count",
        "millimetre",
        "millimetre",
        "centimetre_per_second",
        "millimetre",
        "millimetre",
        "millimetre",
        "centimetre_per_second",
        "millimetre",
        "millimetre",
        "millimetre",
        "centimetre_per_second",
        "millimetre",
        "boolean",
        "enum",
        "millimetre",
        "arbitrary_unit",
        "arbitrary_unit",
        "millimetre",
        "decibel_milliwatt",
        "count",
        "second",
        "millisecond",
        "millisecond",
        "millisecond",
        "millisecond"
      ],
      "sequence_channel": "seq",
      "timing": {
        "timestamp_source": "host_arrival_corrected",
        "correction_channel": "correction_ms"
      }
    },
    {
      "key": "bio",
      "source_id": "study_runner.am_hub.bio",
      "type": "BIO",
      "nominal_rate_hz": 10,
      "clock_domain": "lsl",
      "channel_format": "double64",
      "channels": [
        "heartBpm",
        "breathRate",
        "bioDist",
        "bioT1x",
        "bioT1y",
        "rssi",
        "seq",
        "hub_timestamp",
        "latency_ms",
        "radio_rtt_ms",
        "clock_offset_ms",
        "correction_ms"
      ],
      "channel_units": [
        "beats_per_minute",
        "breaths_per_minute",
        "centimetre",
        "millimetre",
        "millimetre",
        "decibel_milliwatt",
        "count",
        "second",
        "millisecond",
        "millisecond",
        "millisecond",
        "millisecond"
      ],
      "sequence_channel": "seq",
      "timing": {
        "timestamp_source": "host_arrival_corrected",
        "correction_channel": "correction_ms"
      }
    },
    {
      "key": "valves",
      "source_id": "study_runner.am_hub.valves",
      "type": "VALVES",
      "nominal_rate_hz": 0,
      "clock_domain": "lsl",
      "channel_format": "double64",
      "channels": [
        "CH0",
        "CH1",
        "CH2",
        "CH3",
        "CH4",
        "CH5",
        "CH6",
        "CH7",
        "rssi",
        "seq",
        "hub_timestamp",
        "latency_ms",
        "radio_rtt_ms",
        "clock_offset_ms",
        "correction_ms"
      ],
      "channel_units": [
        "boolean",
        "boolean",
        "boolean",
        "boolean",
        "boolean",
        "boolean",
        "boolean",
        "boolean",
        "decibel_milliwatt",
        "count",
        "second",
        "millisecond",
        "millisecond",
        "millisecond",
        "millisecond"
      ],
      "sequence_channel": "seq",
      "may_be_empty": true,
      "timing": {
        "timestamp_source": "host_arrival_corrected",
        "correction_channel": "correction_ms"
      }
    },
    {
      "key": "hub_events",
      "source_id": "study_runner.am_hub.hub_events",
      "type": "HUB_EVENTS",
      "nominal_rate_hz": 0,
      "estimated_bytes_per_second": 49152,
      "clock_domain": "lsl",
      "channel_format": "string",
      "channels": [
        "event"
      ],
      "channel_units": [
        "json"
      ],
      "timing": {
        "timestamp_source": "host_arrival"
      }
    },
    {
      "key": "hub_clock",
      "source_id": "study_runner.am_hub.hub_clock",
      "type": "HUB_CLOCK",
      "nominal_rate_hz": 0,
      "clock_domain": "lsl",
      "channel_format": "double64",
      "channels": [
        "hub_clock_s",
        "rtt_ms",
        "exchange_offset_s",
        "clock_offset_s",
        "offset_uncertainty_ms",
        "offset_valid",
        "offset_steps",
        "correction_enabled",
        "reply_valid"
      ],
      "channel_units": [
        "second",
        "millisecond",
        "second",
        "second",
        "millisecond",
        "boolean",
        "count",
        "boolean",
        "boolean"
      ],
      "timing": {
        "timestamp_source": "host_arrival"
      }
    }
  ],
  "settings": {
    "machine": {
      "base_url": {
        "type": "string",
        "path": "base_url",
        "default": "",
        "label_key": "pluginSettings.amHub.baseUrl",
        "apply": "restart",
        "scope": "machine",
        "help_key": "pluginHelp.amHub.baseUrl"
      },
      "data_timeout_seconds": {
        "type": "number",
        "unit": "s",
        "path": "data_timeout_seconds",
        "default": 5,
        "minimum": 1,
        "maximum": 120,
        "label_key": "pluginSettings.amHub.dataTimeout",
        "apply": "restart",
        "scope": "machine",
        "help_key": "pluginHelp.amHub.dataTimeout"
      },
      "timestamp_correction": {
        "type": "boolean",
        "path": "timestamp_correction",
        "default": false,
        "label_key": "pluginSettings.amHub.timestampCorrection",
        "apply": "restart",
        "scope": "machine",
        "help_key": "pluginHelp.amHub.timestampCorrection"
      }
    },
    "study": {},
    "card_actions": {}
  },
  "poll_interval_ms": 1000,
  "request_timeout_ms": 1500,
  "clock_domain": "lsl",
  "expected_data_rate": {
    "radar_hz": 10,
    "bio_hz": 10,
    "backup_projection_hz": 1
  },
  "backpressure": {
    "max_in_flight": 1,
    "drop_policy": "latest_status_wins"
  }
}
