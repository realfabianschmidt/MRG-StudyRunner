{
  "api_version": 5,
  "plugin_key": "am_hub",
  "version": "3.0.0",
  "category": "biosignal",
  "config_key": "am_hub",
  "runtime": {
    "entrypoint": "driver.py",
    "protocol": "study-runner-stdio/v1",
    "interactive_stdin": true,
    "modes": [
      "runtime",
      "diagnostics"
    ],
    "sample_delivery": "declared_transport",
    "actions": [
      "start",
      "stop",
      "restart"
    ],
    "trial_events": [
      "start",
      "stop"
    ],
    "can_toggle": true
  },
  "lifecycle": {
    "reinitialize_on_disable": true
  },
  "ui": {
    "label": "AM Hub",
    "description": "Radar, bio and valve frames from the Parasite AM Hub (one sample per real frame), plus the hub's own events.",
    "help_key": "pluginHelp.amHub.intro",
    "order": 120,
    "visibility": {
      "dashboard": true,
      "settings_hub": true,
      "study_settings": true,
      "destination_settings": false
    },
    "extensions": {
      "dashboard": "ui/dashboard.js"
    },
    "timeline": {
      "lane_aliases": [
        "am_hub"
      ],
      "preferred_channels": [
        "presMoveEnergy",
        "presStaticEnergy",
        "heartBpm",
        "breathRate",
        "personX",
        "personY"
      ]
    }
  },
  "capabilities": {
    "study_sensor": {
      "default_enabled": false,
      "default_required": false
    },
    "acquisition_transport": {
      "transport": "network_adapter",
      "delivery": "host_lsl_bridge"
    },
    "lsl_stream_provider": {},
    "recording_source": {
      "artifact": "xdf",
      "primary_stream": "radar"
    },
    "backup_projection": {
      "rate_hz": 1,
      "stale_after_ms": 2500,
      "channels": [
        {
          "output": "presence",
          "stream": "radar",
          "channel": "presence"
        },
        {
          "output": "movement_energy",
          "stream": "radar",
          "channel": "presMoveEnergy"
        },
        {
          "output": "person_distance_mm",
          "stream": "radar",
          "channel": "personDist"
        },
        {
          "output": "heart_rate_bpm",
          "stream": "bio",
          "channel": "heartBpm"
        },
        {
          "output": "breath_rate_per_min",
          "stream": "bio",
          "channel": "breathRate"
        }
      ]
    },
    "health": {},
    "connection": {
      "device_noun_key": "sensorConnection.noun.hub",
      "signal_label_key": "sensorConnection.signal.presence",
      "setup_per_participant": false
    },
    "machine_settings": {},
    "study_settings": {},
    "interval_summary": {},
    "sidecar_export": {},
    "admin_actions": {
      "actions": [
        {
          "key": "auto_reconnect",
          "role": "auto_reconnect",
          "label": "Auto-reconnect",
          "description": "Restore a lost AM Hub connection by itself.",
          "payload_schema": {
            "enabled": {
              "type": "boolean",
              "required": true
            }
          }
        }
      ]
    }
  },
  "streams": [
    {
      "key": "radar",
      "source_id": "study_runner.am_hub.radar",
      "type": "RADAR",
      "nominal_rate_hz": 10,
      "clock_domain": "lsl",
      "channel_format": "double64",
      "channels": [
        "personDist",
        "personX",
        "personY",
        "targetCount",
        "t1x",
        "t1y",
        "t1speed",
        "t1res",
        "t2x",
        "t2y",
        "t2speed",
        "t2res",
        "t3x",
        "t3y",
        "t3speed",
        "t3res",
        "presence",
        "presState",
        "presDist",
        "presMoveEnergy",
        "presStaticEnergy",
        "presDetDist",
        "rssi",
        "seq",
        "hub_timestamp"
      ],
      "channel_units": [
        "millimetre",
        "millimetre",
        "millimetre",
        "count",
        "millimetre",
        "millimetre",
        "centimetre_per_second",
        "millimetre",
        "millimetre",
        "millimetre",
        "centimetre_per_second",
        "millimetre",
        "millimetre",
        "millimetre",
        "centimetre_per_second",
        "millimetre",
        "boolean",
        "enum",
        "millimetre",
        "arbitrary_unit",
        "arbitrary_unit",
        "millimetre",
        "decibel_milliwatt",
        "count",
        "second"
      ],
      "sequence_channel": "seq"
    },
    {
      "key": "bio",
      "source_id": "study_runner.am_hub.bio",
      "type": "BIO",
      "nominal_rate_hz": 10,
      "clock_domain": "lsl",
      "channel_format": "double64",
      "channels": [
        "heartBpm",
        "breathRate",
        "bioDist",
        "bioT1x",
        "bioT1y",
        "rssi",
        "seq",
        "hub_timestamp"
      ],
      "channel_units": [
        "beats_per_minute",
        "breaths_per_minute",
        "centimetre",
        "millimetre",
        "millimetre",
        "decibel_milliwatt",
        "count",
        "second"
      ],
      "sequence_channel": "seq"
    },
    {
      "key": "valves",
      "source_id": "study_runner.am_hub.valves",
      "type": "VALVES",
      "nominal_rate_hz": 0,
      "clock_domain": "lsl",
      "channel_format": "double64",
      "channels": [
        "CH0",
        "CH1",
        "CH2",
        "CH3",
        "CH4",
        "CH5",
        "CH6",
        "CH7",
        "rssi",
        "seq",
        "hub_timestamp"
      ],
      "channel_units": [
        "boolean",
        "boolean",
        "boolean",
        "boolean",
        "boolean",
        "boolean",
        "boolean",
        "boolean",
        "decibel_milliwatt",
        "count",
        "second"
      ],
      "sequence_channel": "seq",
      "may_be_empty": true
    },
    {
      "key": "hub_events",
      "source_id": "study_runner.am_hub.hub_events",
      "type": "HUB_EVENTS",
      "nominal_rate_hz": 0,
      "estimated_bytes_per_second": 16384,
      "clock_domain": "lsl",
      "channel_format": "string",
      "channels": [
        "event"
      ],
      "channel_units": [
        "json"
      ]
    }
  ],
  "settings": {
    "machine": {
      "base_url": {
        "type": "string",
        "path": "base_url",
        "default": "",
        "label_key": "pluginSettings.amHub.baseUrl",
        "apply": "restart",
        "scope": "machine",
        "help_key": "pluginHelp.amHub.baseUrl"
      },
      "data_timeout_seconds": {
        "type": "number",
        "unit": "s",
        "path": "data_timeout_seconds",
        "default": 5,
        "minimum": 1,
        "maximum": 120,
        "label_key": "pluginSettings.amHub.dataTimeout",
        "apply": "restart",
        "scope": "machine",
        "help_key": "pluginHelp.amHub.dataTimeout"
      }
    },
    "study": {},
    "card_actions": {}
  },
  "poll_interval_ms": 1000,
  "request_timeout_ms": 1500,
  "clock_domain": "lsl",
  "expected_data_rate": {
    "radar_hz": 10,
    "bio_hz": 10,
    "backup_projection_hz": 1
  },
  "backpressure": {
    "max_in_flight": 1,
    "drop_policy": "latest_status_wins"
  }
}
