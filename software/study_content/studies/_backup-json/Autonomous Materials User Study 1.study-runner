{
  "study_id": "Autonomous Materials User Study #1",
  "questions": [
    {
      "type": "participant-id",
      "prompt": "Please enter your details for anonymous identification.",
      "fields": {
        "first_name": {
          "enabled": true,
          "use_for_key": true,
          "store": false,
          "required": true
        },
        "last_name": {
          "enabled": true,
          "use_for_key": true,
          "store": false,
          "required": true
        },
        "age_group": {
          "enabled": true,
          "use_for_key": true,
          "store": true,
          "required": true,
          "options": [
            "18-25",
            "26-35",
            "36-45",
            "46-60",
            "60+"
          ]
        },
        "gender": {
          "enabled": false,
          "use_for_key": false,
          "store": false,
          "required": false,
          "options": [
            "Female",
            "Male",
            "Non-binary",
            "Prefer not to say"
          ]
        },
        "childhood_area": {
          "enabled": true,
          "use_for_key": true,
          "store": true,
          "required": true
        },
        "childhood_nearest_city": {
          "enabled": true,
          "use_for_key": true,
          "store": true,
          "required": true
        },
        "birth_place": {
          "enabled": false,
          "use_for_key": false,
          "store": false,
          "required": false
        },
        "birth_date": {
          "enabled": false,
          "use_for_key": false,
          "store": false,
          "required": false
        }
      }
    },
    {
      "type": "mood-meter",
      "prompt": "How do you feel right now? (Choosing one quadrant, more options will appear. Mulitple selection possible.)",
      "allow_multiple": true,
      "word_lists": null,
      "required": true
    },
    {
      "type": "stimulus",
      "title": "Turn towards the material. Observe it.",
      "subtitle": "Pay attention to your sensory impressions. The questionnaire will appear automatically.",
      "warmup_duration_ms": 0,
      "duration_ms": 15000,
      "trigger_type": "timer",
      "trigger_content": "",
      "plugin_actions": {
        "brainbit": {
          "to_touchdesigner": true
        },
        "camera_emotion": {
          "snapshot_interval_ms": 1000
        },
        "osc": {
          "forward_marker": false
        }
      }
    },
    {
      "type": "semantic",
      "prompt": "Rate your perceived animacy of the dynamic material",
      "pairs": [
        [
          "dead",
          "alive"
        ],
        [
          "stagnant",
          "lively"
        ],
        [
          "mechanical",
          "organic"
        ],
        [
          "artificial",
          "lifelike"
        ],
        [
          "apathic",
          "responsive"
        ]
      ],
      "required": true
    },
    {
      "type": "semantic",
      "prompt": "Rate your perceived anthropomorphism of the dynamic material (\"anthrophos\"=human, \"morphos\"=form)",
      "pairs": [
        [
          "fake",
          "natural"
        ],
        [
          "machine-like",
          "human-like"
        ],
        [
          "unconscious",
          "conscious"
        ],
        [
          "artificial",
          "lifelike"
        ],
        [
          "moving rigidly",
          "moving elegantly"
        ]
      ],
      "required": true
    },
    {
      "type": "semantic",
      "prompt": "Rate your perceived likeability of the dynamic material",
      "pairs": [
        [
          "awful",
          "nice"
        ],
        [
          "unattractive",
          "attractive"
        ],
        [
          "unappealing",
          "appealing"
        ],
        [
          "repelling",
          "inviting"
        ]
      ],
      "required": true
    },
    {
      "type": "semantic",
      "prompt": "for later: Rate your perceived intelligence of the dynamic material",
      "pairs": [
        [
          "incompetent",
          "competent"
        ],
        [
          "ignorant",
          "knowledgable"
        ],
        [
          "irresponsible",
          "responsible"
        ],
        [
          "unintelligent",
          "intelligent"
        ],
        [
          "foolish",
          "sensible"
        ]
      ],
      "required": true
    },
    {
      "type": "semantic",
      "prompt": "Rate your perceived safety and comfort",
      "pairs": [
        [
          "insecure",
          "secure"
        ],
        [
          "unsafe",
          "safe"
        ],
        [
          "anxious",
          "calm"
        ],
        [
          "intimidated",
          "at ease"
        ],
        [
          "tense",
          "relaxed"
        ],
        [
          "uncomfortable",
          "comfortable"
        ]
      ],
      "required": true
    },
    {
      "type": "semantic",
      "prompt": "Rate your impression of the dynamic material",
      "pairs": [
        [
          "distant",
          "approachable"
        ],
        [
          "boring",
          "interesting"
        ],
        [
          "unfriendly",
          "friendly"
        ],
        [
          "indifferent",
          "engaging"
        ]
      ],
      "required": true
    },
    {
      "type": "mood-meter",
      "prompt": "How do you feel right now?  (Choosing one quadrant, more options will appear. Mulitple selection possible.)",
      "allow_multiple": true,
      "word_lists": {
        "red": [
          "Enraged",
          "Furious",
          "Frightened",
          "Scared",
          "Panicked",
          "Stressed",
          "Jittery",
          "Shocked",
          "Livid",
          "Furious",
          "Frustrated",
          "Tense",
          "Stunned",
          "Fuming",
          "Frightened",
          "Angry",
          "Nervous",
          "Restless",
          "Anxious",
          "Apprehensive",
          "Worried",
          "Irritated",
          "Annoyed",
          "Repulsed",
          "Troubled",
          "Concerned",
          "Uneasy",
          "Peeved"
        ]
      },
      "required": true
    },
    {
      "type": "text",
      "prompt": "Would you like to add something?",
      "required": true
    },
    {
      "type": "slider",
      "prompt": "Did you like this study?",
      "label_min": "not at all",
      "label_max": "very strongly",
      "required": true
    },
    {
      "type": "finish",
      "title": "Thank you!",
      "prompt": "Your answers have been saved.\nYou can put the device down."
    }
  ],
  "study_settings": {
    "sensors_enabled": true,
    "sensors": {
      "brainbit": true,
      "mini_radar": true,
      "camera_emotion": false
    },
    "plugins": {
      "brainbit": {
        "enabled": true,
        "required": true,
        "settings": {}
      },
      "mini_radar": {
        "enabled": true,
        "required": true,
        "settings": {}
      },
      "camera_emotion": {
        "enabled": false,
        "required": true,
        "settings": {}
      },
      "notion": {
        "enabled": false,
        "required": false,
        "settings": {
          "parent_page_id": "",
          "database_id": "",
          "data_source_id": ""
        }
      },
      "nextcloud": {
        "enabled": false,
        "required": false,
        "settings": {}
      }
    },
    "progress_bar_enabled": false
  }
}